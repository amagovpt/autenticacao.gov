  </ImportGroup>
  <PropertyGroup Label="UserMacros">
    <QtDir>$(PTEID_DIR_QT_6_X64)</QtDir>
    <QtLibSuffix Condition="'$(Configuration)'=='Debug'">d</QtLibSuffix>
    <GeneratedDir>GeneratedFiles\$(Configuration)\</GeneratedDir>
  </PropertyGroup>
  <PropertyGroup>
    <OutDir>..\_Binaries35\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(Configuration)\</IntDir>
    <TargetName>pteidguiV2</TargetName>
    <IgnoreImportLibrary>true</IgnoreImportLibrary>
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>.;$(GeneratedDir);..\_Builds;..\dialogs;..\common;..\applayer;..\cardlayer;..\eidlib;..\CMD\services;..\scap;$(QtDir)\include;$(QtDir)\include\QtCore;$(QtDir)\include\QtGui;$(QtDir)\include\QtWidgets;$(QtDir)\include\QtNetwork;$(QtDir)\include\QtQml;$(QtDir)\include\QtQuick;$(QtDir)\include\QtQuickControls2;$(QtDir)\include\QtConcurrent;$(QtDir)\include\QtPrintSupport;$(QtDir)\include\QtCore5Compat;$(QtDir)\mkspecs\win32-msvc;$(PTEID_POPPLER_QT6)\include\poppler\qt6;$(PTEID_DIR_CURL_X64)\include;$(PTEID_DIR_OPENSSL_X64)\include;$(PTEID_DIR_LIBZIP_X64)\include;$(PTEID_DIR_CJSON_X64)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- /Zc:__cplusplus and /permissive- are required by the Qt 6 headers -->
      <AdditionalOptions>/Zc:__cplusplus /permissive- /utf-8 -Zc:strictStrings -w34100 -w34189 -w44996 %(AdditionalOptions)</AdditionalOptions>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <PreprocessorDefinitions>_WINDOWS;UNICODE;_UNICODE;WIN32;WIN64;NOMINMAX;CURL_STATICLIB;WITH_OPENSSL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ExceptionHandling>Sync</ExceptionHandling>
      <RuntimeTypeInfo>true</RuntimeTypeInfo>
      <TreatWChar_tAsBuiltInType>true</TreatWChar_tAsBuiltInType>
      <WarningLevel>Level3</WarningLevel>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <SuppressStartupBanner>true</SuppressStartupBanner>
    </ClCompile>
    <Link>
      <AdditionalDependencies>Qt6Core$(QtLibSuffix).lib;Qt6Gui$(QtLibSuffix).lib;Qt6Widgets$(QtLibSuffix).lib;Qt6Network$(QtLibSuffix).lib;Qt6Qml$(QtLibSuffix).lib;Qt6Quick$(QtLibSuffix).lib;Qt6QuickControls2$(QtLibSuffix).lib;Qt6Concurrent$(QtLibSuffix).lib;Qt6PrintSupport$(QtLibSuffix).lib;Qt6Core5Compat$(QtLibSuffix).lib;Qt6EntryPoint$(QtLibSuffix).lib;poppler-qt6.lib;libcurl_a.lib;Iphlpapi.lib;Ws2_32.lib;Wldap32.lib;normaliz.lib;zlibstatic.lib;Cryptui.lib;Wintrust.lib;Crypt32.lib;shell32.lib;libcrypto.lib;libssl.lib;libzip.lib;cjson.lib;pteidapplayer.lib;pteidcardlayer.lib;pteidcommon.lib;pteidDlgsWin32.lib;pteid-poppler.lib;pteidlib.lib;cmdServices.lib;scap.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(QtDir)\lib;$(PTEID_POPPLER_QT6)\lib;..\_Binaries35\$(Platform)\$(Configuration);$(PTEID_DIR_CURL_X64)\lib;$(PTEID_XMLSECURITY_X64)\lib;$(PTEID_DIR_OPENSSL_X64)\lib;$(PTEID_DIR_ZLIB_X64)\lib;$(PTEID_DIR_LIBZIP_X64)\lib;$(PTEID_DIR_CJSON_X64)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
