    <ClCompile Include="$(GeneratedDir)moc_gapi.cpp" />
    <ClCompile Include="$(GeneratedDir)moc_singleapplication.cpp" />
    <ClCompile Include="$(GeneratedDir)moc_singleapplication_p.cpp" />
    <ClCompile Include="$(GeneratedDir)qrc_resources.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="autoUpdates.h" />
    <ClInclude Include="Settings.h" />
    <ClInclude Include="certificates.h" />
    <ClInclude Include="concurrent.h" />
    <ClInclude Include="eidguiV2Credentials.h" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="eidguiV2.rc" />
  </ItemGroup>
  <!-- Headers with Q_OBJECT -->
  <ItemGroup>
    <CustomBuild Include="appcontroller.h;gapi.h;singleapplication.h;singleapplication_p.h">
      <Message>MOC %(Filename)%(Extension)</Message>
      <Command>"$(QtDir)\bin\moc.exe" --compiler-flavor=msvc "%(FullPath)" -o "$(GeneratedDir)moc_%(Filename).cpp"</Command>
      <Outputs>$(GeneratedDir)moc_%(Filename).cpp</Outputs>
    </CustomBuild>
  </ItemGroup>
  <!-- QML, images and fonts compiled into the executable -->
  <ItemGroup>
    <QrcInput Include="**\*.qml;**\*.js;images\**;fonts\**;qtquickcontrols2.conf" />
    <CustomBuild Include="resources.qrc">
      <Message>RCC %(Filename)%(Extension)</Message>
      <Command>"$(QtDir)\bin\rcc.exe" -name resources "%(FullPath)" -o "$(GeneratedDir)qrc_resources.cpp"</Command>
      <AdditionalInputs>@(QrcInput)</AdditionalInputs>
      <Outputs>$(GeneratedDir)qrc_resources.cpp</Outputs>
    </CustomBuild>
  </ItemGroup>
  <Target Name="CreateGeneratedDir" BeforeTargets="CustomBuild">
    <MakeDir Directories="$(GeneratedDir)" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>
