      <SuppressStartupBanner>true</SuppressStartupBanner>
    </Link>
    <ResourceCompile>
      <PreprocessorDefinitions>_WINDOWS;UNICODE;WIN32;WIN64;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
    <PreBuildEvent>
      <Command>echo "*********************************************************************************"
IF EXIST %PTEID_CREDENTIALS_FOLDER%\eidguiV2Credentials.h   (
    echo "Copying credentials file %PTEID_CREDENTIALS_FOLDER%\eidguiV2Credentials.h"
    copy "%PTEID_CREDENTIALS_FOLDER%\eidguiV2Credentials.h" "$(ProjectDir)\eidguiV2Credentials.h"
) ELSE (
    echo "%PTEID_CREDENTIALS_FOLDER%\eidguiV2Credentials.h not found."
    echo "Copying credentials file "$(ProjectDir)\eidguiV2Credentials.h.template"
    copy "$(ProjectDir)\eidguiV2Credentials.h.template" "$(ProjectDir)\eidguiV2Credentials.h"
)
echo "*********************************************************************************"</Command>
    </PreBuildEvent>
    <Manifest>
      <EnableDpiAwareness>true</EnableDpiAwareness>
    </Manifest>
  </ItemDefinitionGroup>
