<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <?define var.QMLDIROUTPUT=..\..\..\_Binaries35\x64\Release\ ?>
  <?define var.POPPLER_BIN=$(env.PTEID_POPPLER_QT6)\bin ?>
  <?define var.PTEID_BUILD_FOLDER_X64=..\..\..\_Binaries35\x64\Release\ ?>
  <Fragment>
    <DirectoryRef Id="APPLICATIONFOLDER">

      <Directory Id="FONTSDIR" Name="fonts">
        <Component Id="LatoFont" Guid="{d2c0624a-1839-11ea-8d71-362b9e155667}">
          <File Source="..\..\..\eidguiV2\fonts\lato\Lato-Regular.ttf" KeyPath="yes" />
        </Component>
        <Component Id="MyriadFont" Guid="{A018741E-7F59-4F9F-9D6C-1CD8C47E8E3D}">
          <File Source="..\..\..\eidguiV2\fonts\myriad\MyriadPro-Regular.otf" KeyPath="yes" />
        </Component>
        <Component Id="MyriadFontBold" Guid="{8EAB5A1B-F55C-4DC5-ADDD-6D3E2377BF72}">
          <File Source="..\..\..\eidguiV2\fonts\myriad\MyriadPro-Bold.otf" KeyPath="yes" />
        </Component>
      </Directory>
      
      <Directory Id="WEBDIR" Name="web">
        <Component Id="OAuthPages" Guid="{08F97C8A-7A73-427F-B0F1-86D26ECBAA7E}">
          <File Source="..\..\web\AutenticacaoGov.html" KeyPath="yes" />
          <File Source="..\..\web\AutenticacaoGov_failed.html" />
        </Component>
      </Directory>

      <Component Id="PteidGuiShortcutOpenGL" Guid="{737097CD-3807-40DF-A0A7-9842516BA37B}" KeyPath="yes">
        <Shortcut Id="eidguiV2ShortcutDirect3d"
            Name="Autenticação.Gov Direct3d"
            Description="!(loc.PteidGuiDescr)"
            Target="[APPLICATIONFOLDER]pteidguiV2.exe"
            WorkingDirectory="EIDGUIV2DIR"
            Arguments="-w"/>

        <Shortcut Id="eidguiV2ShortcutSoftware"
            Name="Autenticação.Gov Software"
            Description="!(loc.PteidGuiDescr)"
            Target="[APPLICATIONFOLDER]pteidguiV2.exe"
            WorkingDirectory="EIDGUIV2DIR"
            Arguments="-s"/>

        <Shortcut Id="eidguiV2ShortcutHardware"
            Name="Autenticação.Gov Hardware"
            Description="!(loc.PteidGuiDescr)"
            Target="[APPLICATIONFOLDER]pteidguiV2.exe"
            WorkingDirectory="EIDGUIV2DIR"
            Arguments="-c"/>
      </Component>

      <Component Id="cmp26BEB2EA48F67A67BCF4179409B389BC" Guid="{1F577CCA-570B-40FA-AF98-E2ACCB83E1E4}">
        <File Id="filD0B9B246576CA604C613E588A3104560" KeyPath="yes" Source="$(var.QMLDIROUTPUT)\pteidguiV2.exe" />
        <File Id="fil532B63275F24DCA11F229D2F2A4A6718" Source="..\..\..\eidguiV2\eidmw_nl.qm" />
        <File Id="fil532B63275F24DCA11F229D2F2A4A6719" Source="..\..\..\eidguiV2\eidmw_en.qm" />
      </Component>
      <Component Id="PopplerQt6" Guid="{FF5F52CB-CB07-4B95-8291-4A01D2A9FA65}">
        <File Id="poppler_qt6.dll" KeyPath="yes" Source="$(var.POPPLER_BIN)\poppler-qt6.dll" />
      </Component>
      <Component Id="PopplerCore" Guid="{58DEAFDD-054B-4C05-B728-B284910FEF80}">
        <File Id="poppler.dll" KeyPath="yes" Source="$(var.POPPLER_BIN)\poppler.dll" />
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="PteidGuiShortcut" Guid="{CBD0F388-EAE5-4FA1-8C38-EC223928FF13}">

        <Shortcut Id="eidguiV2StartMenuShortcut"
                          Name="Autenticação.gov"
                          Description="!(loc.PteidGuiDescr)"
                          Target="[APPLICATIONFOLDER]pteidguiV2.exe"
                          WorkingDirectory="eidguiV2Dir"/>

        <Shortcut Id="eidguiV2Shortcut"
            Name="Autenticação.Gov"
            Directory="DesktopFolder"
            Description="!(loc.PteidGuiDescr)"
            Target="[APPLICATIONFOLDER]pteidguiV2.exe"
            WorkingDirectory="EIDGUIV2DIR"/>

        <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall"/>
        <RegistryValue Root="HKCU" Key="SOFTWARE\PTEID\Installer" Name="GuiShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="RegisterPteidAutoStart" Guid="{414DF15C-6CE6-4181-95B4-D83F16903BA6}">
        <RegistryKey Root="HKCU" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run">
          <RegistryValue Type="string" Name="pteid" Value="&quot;[APPLICATIONFOLDER]pteidguiV2.exe&quot;"/>
        </RegistryKey>
      </Component>

    </DirectoryRef>
  </Fragment>
  <Fragment>
    <ComponentGroup Id="qmlAppComponentGroup">
      <!-- Qt runtime deployed by windeployqt, harvested at build time (Autenticacao.gov-3.0-64.wixproj) -->
      <ComponentGroupRef Id="QtRuntime"/>
      <ComponentRef Id="PteidGuiShortcut"/>
      <ComponentRef Id="PteidGuiShortcutOpenGL"/>
      <ComponentRef Id="RegisterPteidAutoStart"/>
      <ComponentRef Id="LatoFont"/>
      <ComponentRef Id="MyriadFont"/>
      <ComponentRef Id="MyriadFontBold"/>
      <ComponentRef Id="OAuthPages"/>
      <ComponentRef Id="cmp26BEB2EA48F67A67BCF4179409B389BC" />
      <ComponentRef Id="PopplerQt6" />
      <ComponentRef Id="PopplerCore" />
    </ComponentGroup>
  </Fragment>
</Wix>