<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProductVersion>3.10</ProductVersion>
    <ProjectGuid>{da88ba5a-fb08-468f-9ddb-e8dcb311a339}</ProjectGuid>
    <SchemaVersion>2.0</SchemaVersion>
    <OutputName>Autenticacao.gov_Win_x64</OutputName>
    <OutputType>Package</OutputType>
    <WixTargetsPath Condition=" '$(WixTargetsPath)' == '' AND '$(MSBuildExtensionsPath32)' != '' ">$(MSBuildExtensionsPath32)\Microsoft\WiX\v3.x\Wix.targets</WixTargetsPath>
    <WixTargetsPath Condition=" '$(WixTargetsPath)' == '' ">$(MSBuildExtensionsPath)\Microsoft\WiX\v3.x\Wix.targets</WixTargetsPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
    <DefineConstants>Debug</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <DefineConstants>Debug</DefineConstants>
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
    <SuppressIces>ICE09;ICE60;ICE03</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Strings-pt.wxl">
      <Link>Strings-pt.wxl</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="ui-config.wxl" />
  </ItemGroup>
  <ItemGroup>
    <WixExtension Include="WixDifxAppExtension">
      <HintPath>$(WixExtDir)\WixDifxAppExtension.dll</HintPath>
      <Name>WixDifxAppExtension</Name>
    </WixExtension>
    <WixExtension Include="WixUtilExtension">
      <HintPath>$(WixExtDir)\WixUtilExtension.dll</HintPath>
      <Name>WixUtilExtension</Name>
    </WixExtension>
    <WixExtension Include="WixUIExtension">
      <HintPath>$(WixExtDir)\WixUIExtension.dll</HintPath>
      <Name>WixUIExtension</Name>
    </WixExtension>
  </ItemGroup>
  <ItemGroup>
    <WixLibrary Include="difxapp_x64">
      <HintPath>C:\Program Files (x86)\Windows Installer XML v3.5\bin\difxapp_x64.wixlib</HintPath>
      <Name>difxapp_x64</Name>
    </WixLibrary>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Product64-3.0.wxs" />
    <Compile Include="qml-app.wxs" />
  </ItemGroup>
  <!--
    Qt runtime of the application: the directory windeployqt deployed pteidguiV2.exe into
    (PTEID_DIR_QML_X64), harvested into the QtRuntime component group at build time so
    the package follows the Qt version. Component GUIDs are derived from the install paths.
  -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);QMLDIR=$(PTEID_DIR_QML_X64)</DefineConstants>
    <HarvestDirectoryAutogenerateGuids>true</HarvestDirectoryAutogenerateGuids>
    <HarvestDirectorySuppressRegistry>true</HarvestDirectorySuppressRegistry>
    <HarvestDirectorySuppressCom>true</HarvestDirectorySuppressCom>
  </PropertyGroup>
  <Import Project="$(WixTargetsPath)" />
  <!--
    The HarvestDirectory item is added at build time: Visual Studio cannot show an item outside
    the project directory and refuses to load the project. With PTEID_DEPLOY_QT=1 the Qt runtime
    of pteidguiV2.exe is first deployed into PTEID_DIR_QML_X64 with windeployqt, instead of using
    a directory deployed beforehand.
  -->
  <PropertyGroup>
    <!-- First dependency of Harvest: HarvestDirectory checks for items before BeforeTargets run -->
    <HarvestDependsOn>AddQtRuntime;$(HarvestDependsOn)</HarvestDependsOn>
  </PropertyGroup>
  <Target Name="AddQtRuntime">
    <RemoveDir Directories="$(PTEID_DIR_QML_X64)" Condition="'$(PTEID_DEPLOY_QT)' == '1'" />
    <!-- windeployqt follows the dependencies of every DLL, poppler-qt6.dll included -->
    <Exec StandardOutputImportance="high" StandardErrorImportance="high" Command="set &quot;PATH=$(PTEID_POPPLER_QT6)\bin;%PATH%&quot; &amp;&amp; &quot;$(PTEID_DIR_QT_6_X64)\bin\windeployqt.exe&quot; --release --no-compiler-runtime --qmldir &quot;$(ProjectDir)..\..\..\eidguiV2&quot; --dir &quot;$(PTEID_DIR_QML_X64)&quot; &quot;$(ProjectDir)..\..\..\_Binaries35\x64\Release\pteidguiV2.exe&quot;" Condition="'$(PTEID_DEPLOY_QT)' == '1'" />
    <ItemGroup>
      <HarvestDirectory Include="$(PTEID_DIR_QML_X64)">
        <DirectoryRefId>APPLICATIONFOLDER</DirectoryRefId>
        <ComponentGroupName>QtRuntime</ComponentGroupName>
        <PreprocessorVariable>var.QMLDIR</PreprocessorVariable>
        <SuppressRootDirectory>true</SuppressRootDirectory>
      </HarvestDirectory>
    </ItemGroup>
  </Target>
  <PropertyGroup>
    <PreBuildEvent>cmd.exe /C "$(ProjectDir)..\..\..\eidlibdotnetsdk\build.bat  $(ProjectDir)\..\..\..\_Binaries35\AnyCPU\Release\"</PreBuildEvent>
  </PropertyGroup>
  <!--
	To modify your build process, add your task inside one of the targets below and uncomment it.
	Other similar extension points exist, see Wix.targets.
	<Target Name="BeforeBuild">
	</Target>
	<Target Name="AfterBuild">
	</Target>
	-->
</Project>